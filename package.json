  "description": "Langfuse integration CLI for AI agents, with WorkBuddy support",
  "bin": {
    "langfuse-helper": "bin/langfuse-helper.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "collector/",
    "plugins/",
    ".codebuddy-plugin/",
    "docs/"
  ],
  "os": [
    "darwin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fine405/workbuddy-langfuse-plugin.git"
  }
