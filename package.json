{
  "name": "langfuse-helper",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run build && node --test test/*.test.mjs",
    "test:collector": "node scripts/test-collector.mjs",
    "test:plugin": "node scripts/test-plugin.mjs",
    "test:langfuse": "node scripts/test-langfuse.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "build": "node scripts/build.mjs",
    "test:codex:langfuse": "npm run build && node scripts/test-codex-langfuse.mjs"
  },
  "description": "Discover local AI agents and connect WorkBuddy and Codex to Langfuse",
  "bin": {
    "langfuse-helper": "bin/langfuse-helper.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "collector/",
    "plugins/",
    ".codebuddy-plugin/",
    "docs/",
    ".agents/plugins/marketplace.json"
  ],
  "os": [
    "darwin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fine405/workbuddy-langfuse-plugin.git"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
